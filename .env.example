# Public origin used for metadata and as a fallback for webhook URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional repository link. The GitHub icon is hidden when empty.
NEXT_PUBLIC_GITHUB_URL=

# Required in production. At least 16 characters. Signs the read cookie.
FISHOOK_COOKIE_SECRET=

# Leave both empty for the local file store at .data/store.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional shared rate limiter. Falls back to an in-process map when empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional local store directory.
# FISHOOK_DATA_DIR=/absolute/path
